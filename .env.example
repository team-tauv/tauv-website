# ---------------------------------------------------------------------------
# Sanity.io
# Değerleri https://www.sanity.io/manage adresindeki proje ayarlarından alın.
# NEXT_PUBLIC_ ön eki taşıyanlar tarayıcıya gönderilir; token ASLA public olmaz.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-05"

# Live Content API ve taslak önizleme için. Viewer yetkisi yeterli.
# Boş bırakılırsa site derlenir ve çalışır; yalnızca canlı içerik güncellemesi
# ve taslak önizleme devre dışı kalır.
# ⚠️  Bu dosya git'e dahildir — buraya ASLA gerçek değer yazmayın.
#     Gerçek değerler .env.local dosyasına gider (git tarafından yok sayılır).
SANITY_API_READ_TOKEN=""

# ---------------------------------------------------------------------------
# İletişim formu (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="iletisim@tauv.example"
CONTACT_TO_EMAIL="tauv@tau.edu.tr"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
