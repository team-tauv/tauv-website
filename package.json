{
  "name": "tauv-website",
  "version": "0.1.0",
  "private": true,
  "description": "Türk-Alman Üniversitesi İnsansız Su Altı Sistemleri Takımı (TAUV) resmî web sitesi",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:typegen": "sanity schema extract --path=./sanity/extract.json --force && sanity typegen generate",
    "model:inspect": "gltf-transform inspect",
    "model:optimize": "node scripts/optimize-model.mjs",
    "sanity:seed:packages": "sanity exec scripts/seed-sponsorship-packages.ts --with-user-token"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@hookform/resolvers": "^5.7.1",
    "@portabletext/react": "^7.0.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sanity/image-url": "^2.1.1",
    "@sanity/language-filter": "^5.0.14",
    "@sanity/vision": "^6.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-sanity": "^13.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sanity": "^6.9.0",
    "sanity-plugin-internationalized-array": "^5.1.25",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
